MCP_COMMAND=node
MCP_ARGS=../mcp-server/gmail/dist/index.js
MCP_HTTP_PORT=3301
DEBUG=false
ENABLE_DEMO_ROUTES=true

# Attachment sandbox for send_email/draft_email path validation.
# Uses ATTACHMENT_SANDBOX_ROOT when set, otherwise defaults to OS temp dir + /agent-ui-attachments.
# Keep this aligned with agent-ui AGENT_UPLOAD_TEMP_DIR.
ATTACHMENT_SANDBOX_ROOT=/tmp/agent-ui-attachments

OPA_ENABLED=true
OPA_DECISION_URL=http://localhost:8181/v1/data/gmail/decision
OPA_TIMEOUT_MS=2000
OPA_FAIL_OPEN=false
IMMUDB_ENABLED=true
IMMUDB_HOST=127.0.0.1
IMMUDB_PORT=3322
IMMUDB_USER=immudb
IMMUDB_PASSWORD=immudb
IMMUDB_DATABASE=defaultdb
IMMUDB_MODE=kv

# Redis Configuration (for rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=          # Optional, for Redis 6.0+ ACL authentication
REDIS_PASSWORD=          # Optional, leave empty if no password

# Rate Limiting Configuration
# Format: RATE_LIMIT_{SCOPE}_{ACTION}=count:window_seconds
# Supported scopes: IDENTITY (user), IP (IP address), USERAGENT (user agent)
# Set RATE_LIMIT_ENABLED=false to disable rate limiting
RATE_LIMIT_ENABLED=true

# Default rate limits per scope (applied to all actions if not specifically configured)
# Format: RATE_LIMIT_{SCOPE}_DEFAULT=count:window
RATE_LIMIT_IDENTITY_DEFAULT=20:60      # 20 requests per user per 60 seconds
RATE_LIMIT_IP_DEFAULT=100:60           # 100 requests per IP per 60 seconds
RATE_LIMIT_USERAGENT_DEFAULT=50:60     # 50 requests per user-agent per 60 seconds

# Action-specific rate limits by identity (user)
# Format: RATE_LIMIT_IDENTITY_{ACTION}=count:window
RATE_LIMIT_IDENTITY_SEND_EMAIL=3:60         # User can send 3 emails per minute
RATE_LIMIT_IDENTITY_SEARCH_EMAILS=20:60     # User can search 20 times per minute
RATE_LIMIT_IDENTITY_DELETE_EMAIL=10:60      # User can delete 10 emails per minute
RATE_LIMIT_IDENTITY_CREATE_DRAFT=10:60      # User can create 10 drafts per minute

# Action-specific rate limits by IP address
# Format: RATE_LIMIT_IP_{ACTION}=count:window
RATE_LIMIT_IP_SEND_EMAIL=10:60              # IP can send 10 emails per minute
RATE_LIMIT_IP_SEARCH_EMAILS=50:60           # IP can search 50 times per minute

# Action-specific rate limits by user agent
# Format: RATE_LIMIT_USERAGENT_{ACTION}=count:window
RATE_LIMIT_USERAGENT_SEND_EMAIL=20:60       # User agent can send 20 emails per minute

# Notes:
# - If a request violates ANY scope limit, it will be denied
# - Action names are normalized: hyphens become underscores, lowercase
# - You can add custom scopes beyond IDENTITY, IP, USERAGENT
# - If no limit is configured for a scope+action, requests are allowed
