OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4.1-mini
MCP_HTTP_URL=http://localhost:3301
PORT=3300
DEBUG=false

# Attachment upload handling
# Directory used to store uploaded attachments temporarily during /api/assist requests.
# Uses AGENT_UPLOAD_TEMP_DIR when set, otherwise defaults to OS temp dir + /agent-ui-attachments.
# Keep this aligned with gmail-mcp-http ATTACHMENT_SANDBOX_ROOT.
AGENT_UPLOAD_TEMP_DIR=/tmp/agent-ui-attachments

# Optional JSON body size limit for /api/assist uploads.
# Increase if you need larger attachments.
REQUEST_JSON_LIMIT=15mb

# RAG (Retrieval Augmented Generation) Configuration
# Set OPENAI_VECTOR_STORE_ID to enable RAG from your knowledge base
# Run 'npm run setup-vector-store' first to create and populate the vector store
OPENAI_VECTOR_STORE_ID=
RAG_TOP_K=5
RAG_MIN_SCORE=0.6

# Entra ID (Azure AD) OAuth2
# Required for Entra ID authentication (if AUTHENTICATED_USER is not set)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Optional: User identifier for authentication
# Set this to bypass Entra ID login (useful for demos and CI/CD)
# If not set, the CLI will prompt for browser-based or device code authentication
# Example: AUTHENTICATED_USER=demo-user
AUTHENTICATED_USER=

# Optional: Demo timestamp for policy evaluation
# Set this to test OPA policies at a specific point in time (ISO 8601 format)
# Only works when ENABLE_DEMO_ROUTES=true on the MCP HTTP server
# Example: DEMO_TIMESTAMP=2026-03-11T10:00:00.000Z
DEMO_TIMESTAMP=

# Session
SESSION_SECRET=your-secret-key-change-in-production

# Optional OAuth2 redirect overrides
REDIRECT_URI=http://localhost:3300/auth/callback
POST_LOGOUT_REDIRECT_URI=http://localhost:3300
